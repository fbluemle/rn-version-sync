{
  "name": "rn-versioning",
  "version": "0.10.0",
  "description": "Fast and simple utility to sync the React Native version with native code and find the next version code in the stores",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "bin": {
    "rn-versioning": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fbluemle/rn-versioning.git"
  },
  "keywords": [
    "CFBundleShortVersionString",
    "CFBundleVersion",
    "android",
    "ios",
    "react-native",
    "version",
    "versionCode",
    "versionName"
  ],
  "author": "Frieder Bluemle <frieder.bluemle@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/fbluemle/rn-versioning/issues"
  },
  "homepage": "https://github.com/fbluemle/rn-versioning",
  "dependencies": {
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
