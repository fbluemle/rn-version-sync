{
  "name": "rn-version-sync",
  "version": "0.4.1",
  "description": "Fast and simple utility to sync React Native version with native code",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "bin": {
    "rn-version-sync": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fbluemle/rn-version-sync.git"
  },
  "keywords": [
    "CFBundleShortVersionString",
    "CFBundleVersion",
    "android",
    "ios",
    "react-native",
    "version",
    "versionCode",
    "versionName"
  ],
  "author": "Frieder Bluemle <frieder.bluemle@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/fbluemle/rn-version-sync/issues"
  },
  "homepage": "https://github.com/fbluemle/rn-version-sync",
  "dependencies": {
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
